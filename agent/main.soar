# The starting agent (docs/spec.md, "The base"): the least that lets it act, and nothing about any environment.
# Every action the adapter lists is proposed, all equally (indifferent), so Soar picks one at random; the chosen
# one is written to the output link; once the adapter marks it complete, it is cleared.

sp {propose*act
   (state <s> ^superstate nil ^io.input-link.env.actions.action <a> ^io.output-link <ol>)
   (<a> ^name <n> -^param x)
  -(<ol> ^act)
-->
   (<s> ^operator <o> + =)
   (<o> ^name act ^action <n>)}

sp {apply*act
   (state <s> ^operator <o> ^io.output-link <ol>)
   (<o> ^name act ^action <n> -^x)
-->
   (<ol> ^act <c>)
   (<c> ^action <n>)}

sp {propose*clear-act
   (state <s> ^superstate nil ^io.output-link.act.status complete)
-->
   (<s> ^operator <o> + >)
   (<o> ^name clear-act)}

sp {apply*clear-act
   (state <s> ^operator.name clear-act ^io.output-link <ol>)
   (<ol> ^act <c>)
-->
   (<ol> ^act <c> -)}

source navigate.soar

# An action that takes a point (^param x, ^param y): with nothing better to go on, a point at random, chosen when
# the operator is proposed and written with the command in one rule (the proposal is withdrawn as soon as a command
# exists, so nothing can be added to it after).
sp {propose*act*point
   (state <s> ^superstate nil ^io.input-link.env.actions.action <a> ^io.output-link <ol>)
   (<a> ^name <n> ^param x)
  -(<ol> ^act)
-->
   (<s> ^operator <o> + =)
   (<o> ^name act ^action <n> ^x (rand-int 63) ^y (rand-int 63))}

sp {apply*act*point
   (state <s> ^operator <o> ^io.output-link <ol>)
   (<o> ^name act ^action <n> ^x <x> ^y <y>)
-->
   (<ol> ^act <c>)
   (<c> ^action <n> ^x <x> ^y <y>)}
